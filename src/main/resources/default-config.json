{
  "enabled": false,
  "targets": {
    "ntfy": {
      "type": "ntfy",
      "enabled": false,
      "url": "https://ntfy.sh/YOUR_TOPIC",
      "markdown": true,
      "defaultPriority": "default",
      "defaultIcon": "https://raw.githubusercontent.com/jeppestaerk/Hytale-Plugin-Valhal-EventNotifications/main/assets/Hytale-Logo.png",
      "events": {
        "serverStart": {
          "enabled": true,
          "title": "{server} - Online",
          "message": "The server is now **online** and ready for players!",
          "tags": "green_circle"
        },
        "serverStop": {
          "enabled": true,
          "title": "{server} - Offline",
          "message": "The server is **shutting down**.",
          "tags": "red_circle"
        },
        "playerJoin": {
          "enabled": true,
          "title": "{server} - Player Joined",
          "message": "**{player}** joined the server",
          "tags": "video_game"
        },
        "playerLeave": {
          "enabled": true,
          "title": "{server} - Player Left",
          "message": "**{player}** left the server",
          "tags": "door"
        },
        "playerChat": {
          "enabled": false,
          "title": "{server} - Chat",
          "message": "**{player}**: {message}",
          "tags": "speech_balloon"
        },
        "groupPermissionChange": {
          "enabled": true,
          "title": "{server} - Permissions",
          "message": "Group **{group}**: {action} permissions `{permissions}`",
          "tags": "shield"
        },
        "playerPermissionChange": {
          "enabled": true,
          "title": "{server} - Permissions",
          "message": "Player `{player}` {action} {group}{permissions}",
          "tags": "key"
        },
        "gameModeChange": {
          "enabled": true,
          "title": "{server} - Game Mode",
          "message": "Game mode changed to **{gamemode}**",
          "tags": "joystick"
        }
      }
    },
    "discord": {
      "type": "discord",
      "enabled": false,
      "url": "https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN",
      "discordAvatarUrl": "https://raw.githubusercontent.com/jeppestaerk/Hytale-Plugin-Valhal-EventNotifications/main/assets/Hytale-Logo.png",
      "discordUseEmbeds": true,
      "events": {
        "serverStart": {
          "enabled": true,
